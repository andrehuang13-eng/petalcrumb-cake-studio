# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example IS committed (template for collaborators).

# === Database (Neon Postgres) ===
# Pooled connection — used by the app at runtime (hostname has "-pooler")
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Direct connection — used by Prisma for migrations (no "-pooler" in hostname)
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# === Email (Resend) ===
# Used by the order-request form to notify the studio of new submissions.
# Get a key at https://resend.com (free tier: 3000 emails / month).
# If unset, submissions still save to the DB but no email is sent.
RESEND_API_KEY=""

# Where new-order notifications are delivered.
# For this concept project: your personal Gmail.
# In production this would route to studio@petalcrumb.co.uk (verified domain).
ORDER_REQUEST_TO_EMAIL=""
