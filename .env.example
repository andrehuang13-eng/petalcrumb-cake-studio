# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example IS committed (template for collaborators).

# === Database (Neon Postgres) ===
# Pooled connection — used by the app at runtime (hostname has "-pooler")
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Direct connection — used by Prisma for migrations (no "-pooler" in hostname)
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"
